rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mpaulamh@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection (RBAC profile)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      // On create, standard users must register with 'asesor' role unless caller is admin or bootstrap admin
      allow create: if isValidId(userId) && isSignedIn() && (
        (isOwner(userId) && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'asesor' && request.resource.data.status == 'active') ||
        isAdmin()
      );

      // On update, users can only update display info and lastLogin; role/status changes require isAdmin()
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt']))
      );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins Collection (Security markers)
    match /admins/{userId} {
      allow read: if isValidId(userId) && isSignedIn();
      allow write: if isValidId(userId) && isAdmin();
    }

    // Comparisons Collection (Saved proposals history)
    match /comparisons/{comparisonId} {
      allow get: if isValidId(comparisonId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(comparisonId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isValidId(comparisonId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
    }

    // Audit Logs Collection (Immutable security audit trail)
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable logs
    }
  }
}
